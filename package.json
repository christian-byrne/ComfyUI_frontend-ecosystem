{
  "name": "comfyui-frontend-ecosystem",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "verify:quick": "pnpm typecheck",
    "rebuild": "bash scripts/rebuild.sh",
    "rebuild:offline": "bash scripts/rebuild.sh --skip-stars",
    "data:rollup": "bash scripts/rebuild.sh rollup",
    "data:stars": "bash scripts/rebuild.sh stars",
    "data:verify": "bash scripts/rebuild.sh data",
    "prepare": "husky",
    "sync:knowledge": "bash scripts/sync-knowledge.sh"
  },
  "dependencies": {
    "@unhead/vue": "^3.1.0",
    "@vueuse/core": "^11.2.0",
    "@vueuse/router": "^11.2.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.5",
    "marked": "^18.0.3",
    "marked-gfm-heading-id": "^4.1.4",
    "pinia": "^2.2.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-checker": "^0.14.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.8",
    "vue-axe": "^2.4.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.4"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
